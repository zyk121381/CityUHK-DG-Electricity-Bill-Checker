# ============================================================
# 复制成 .env，填入真实值。
# 每个渠道要填什么、去哪拿，看 README 的「推送」一节。
# ============================================================


# ============================================================
#  一表通（onebill.cityu-dg.edu.cn）
# ============================================================

# auth.mode = password：学号 + 密码，全自动换 token
EPAY_ACCOUNT=
EPAY_PASSWORD=

# 兜底：password 不通时手动填一个 token（python run.py token）
EPAY_TOKEN=

# 备用：只有把 auth.mode 切回 sso 时才需要
IDP_COOKIE=


# ============================================================
#  推送渠道
# ============================================================

# =========== 启用哪些渠道 ===========
# 逗号分隔。可选：showdoc / wxpusher / pushplus / serverchan / feishu / wecom_bot / email / webhook
# 留空 = 不推送（只生成报告）
NOTIFY_CHANNELS=

# =========== ShowDoc ===========
SHOWDOC_URL=

# =========== WxPusher ===========
WXPUSHER_SPT=
# 正文格式：1 文字 / 2 HTML / 3 Markdown
WXPUSHER_CONTENT_TYPE=2

# =========== PushPlus ===========
PUSHPLUS_TOKEN=
# 群组编码，可选
PUSHPLUS_TOPIC=

# =========== Server酱 ===========
SERVERCHAN_SENDKEY=

# =========== 飞书群机器人 ===========
FEISHU_WEBHOOK=

# =========== 企业微信群机器人 ===========
WECOM_WEBHOOK=

# =========== 邮箱（SMTP）===========
# 任何提供 SMTP 服务的邮箱都可以，HOST/PORT 查服务商说明
SMTP_HOST=
SMTP_PORT=465
# true = 465 端口直接 SSL；false = 587 端口 STARTTLS
SMTP_SSL=true
# 发件人完整邮箱地址
SMTP_USER=
# 多数服务商要授权码 / 应用专用密码，不是登录密码
SMTP_PASSWORD=
# 收件人，多个用逗号分隔
SMTP_TO=
# 邮件标题前缀
SMTP_SUBJECT_PREFIX=

# =========== 自定义 Webhook ===========
WEBHOOK_URL=
